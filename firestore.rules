rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // System settings & config - restricted write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if false; // Only modified via secure server admin routes
    }

    match /systemSettings/{settingId} {
      allow read: if true;
      allow write: if false;
    }

    // Immutable Transaction History
    match /transactions/{txId} {
      allow read: if isAuthenticated() || true;
      allow create: if true;
      allow update, delete: if false;
    }

    // User accounts
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false; // Account deletions must go through admin API
    }

    // Audit logs & admin logs - append-only/server-only
    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    match /adminLogs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Withdrawals & Requests
    match /withdrawals/{withdrawalId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    match /withdraw_requests/{requestId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // Live Redeem & Events
    match /liveRedeem/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /liveRedeemEvents/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /liveRedeemEventsHistory/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Giveaways & Wars
    match /giveaways/{giveawayId} {
      allow read: if true;
      allow write: if true;
    }

    match /giveawayWars/{warId} {
      allow read: if true;
      allow write: if true;
    }

    // Contests & Votes
    match /contests/{contestId} {
      allow read: if true;
      allow write: if true;
    }

    match /contestants/{contestantId} {
      allow read: if true;
      allow write: if true;
    }

    match /voteLogs/{voteId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Hall of Fame
    match /hallOfFame/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Banned devices & fingerprints
    match /bannedDevices/{devId} {
      allow read: if true;
      allow write: if false;
    }

    match /deviceFingerprints/{fpId} {
      allow read: if true;
      allow write: if true;
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
