      "required": ["botToken", "adminTelegramId", "mainChannelUsername", "mainGroupUsername"]
    },
    "logs": {
      "title": "System Logs",
      "description": "Activity, registration, withdrawal, referral, and error logs",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" },
        "details": { "type": "object" }
      },
      "required": ["type", "message", "timestamp"]
