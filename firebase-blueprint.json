        "mainGroupUsername": { "type": "string" },
        "forceJoinEnabled": { "type": "boolean" },
        "autoVerificationEnabled": { "type": "boolean" },
        "channelVerified": { "type": "boolean" },
        "groupVerified": { "type": "boolean" },
        "registrationBonus": { "type": "number" },
        "referralBonus": { "type": "number" },
        "minWithdrawal": { "type": "number" },
        "maxWithdrawal": { "type": "number" },
        "withdrawalTax": { "type": "number" },
        "uidLength": { "type": "number" },
