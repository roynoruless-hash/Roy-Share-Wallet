{
  "entities": {
    "settings": {
      "title": "System Settings",
      "description": "Global Admin Configuration for Telegram Bot",
      "type": "object",
      "properties": {
        "botToken": { "type": "string" },
        "botUsername": { "type": "string" },
        "botName": { "type": "string" },
        "botId": { "type": "string" },
        "adminTelegramId": { "type": "string" },
        "adminChatId": { "type": "string" },
        "mainChannelUsername": { "type": "string" },
        "mainGroupUsername": { "type": "string" },
        "forceJoinEnabled": { "type": "boolean" },
        "autoVerificationEnabled": { "type": "boolean" },
        "channelVerified": { "type": "boolean" },
        "groupVerified": { "type": "boolean" },
        "registrationBonus": { "type": "number" },
        "referralBonus": { "type": "number" },
        "minWithdrawal": { "type": "number" },
        "maxWithdrawal": { "type": "number" },
        "withdrawalTax": { "type": "number" },
        "uidLength": { "type": "number" },
        "enableWithdraw": { "type": "boolean" },
        "enableUpi": { "type": "boolean" },
        "enableQr": { "type": "boolean" },
        "enableRedeemCode": { "type": "boolean" },
        "processingTimeNotice": { "type": "string" },
        "referralEnable": { "type": "boolean" },
        "rewardPerReferral": { "type": "number" },
        "selfReferralProtection": { "type": "boolean" },
        "duplicateReferralProtection": { "type": "boolean" },
        "supportUsername": { "type": "string" },
        "supportGroup": { "type": "string" },
        "maintenanceMode": { "type": "boolean" },
        "allowedAdminIds": { "type": "string" },
        "sessionTimeout": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["botToken", "adminTelegramId", "mainChannelUsername", "mainGroupUsername"]
    },
    "logs": {
      "title": "System Logs",
      "description": "Activity, registration, withdrawal, referral, and error logs",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "message": { "type": "string" },
        "timestamp": { "type": "string" },
        "details": { "type": "object" }
      },
      "required": ["type", "message", "timestamp"]
    },
    "users": {
      "title": "Registered Bot Users",
      "description": "User accounts registered via Telegram bot onboarding",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "telegramId": { "type": "string" },
        "username": { "type": "string" },
        "firstName": { "type": "string" },
        "mobile": { "type": "string" },
        "walletBalance": { "type": "number" },
        "channelVerified": { "type": "boolean" },
        "groupVerified": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "referrerUid": { "type": "string" },
        "referredBy": { "type": "string" },
        "referralRewardReceived": { "type": "boolean" },
        "totalReferrals": { "type": "number" },
        "successfulReferrals": { "type": "number" },
        "totalReferralEarnings": { "type": "number" },
        "status": { "type": "string" },
        "banned": { "type": "boolean" },
        "banReason": { "type": "string" },
        "lastActive": { "type": "string" }
      },
      "required": ["uid", "telegramId", "firstName", "mobile", "walletBalance", "channelVerified", "groupVerified", "createdAt"]
    },
    "transactions": {
      "title": "Wallet Transactions",
      "description": "Ledger of credits, debits, referral rewards, and withdrawals",
      "type": "object",
      "properties": {
        "transactionId": { "type": "string" },
        "userId": { "type": "string" },
        "uid": { "type": "string" },
        "telegramId": { "type": "string" },
        "fullName": { "type": "string" },
        "mobile": { "type": "string" },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "balanceBefore": { "type": "number" },
        "balanceAfter": { "type": "number" },
        "status": { "type": "string" },
        "description": { "type": "string" },
        "reason": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["transactionId", "uid", "telegramId", "fullName", "mobile", "type", "amount", "balanceBefore", "balanceAfter", "status", "description", "createdAt"]
    },
    "adminLogs": {
      "title": "Admin Audit Logs",
      "description": "Log of admin actions on users and system settings",
      "type": "object",
      "properties": {
        "adminId": { "type": "string" },
        "action": { "type": "string" },
        "targetUid": { "type": "string" },
        "targetTelegramId": { "type": "string" },
        "amount": { "type": "number" },
        "reason": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["adminId", "action", "targetUid", "timestamp"]
    },
    "referralTokens": {
      "title": "Referral Verification Tokens",
      "description": "Anti self-referral verification links and device fingerprints",
      "type": "object",
      "properties": {
        "token": { "type": "string" },
        "referrerUid": { "type": "string" },
        "referredUid": { "type": "string" },
        "referredTelegramId": { "type": "string" },
        "referredName": { "type": "string" },
        "deviceFingerprint": { "type": "string" },
        "ipAddress": { "type": "string" },
        "userAgent": { "type": "string" },
        "status": { "type": "string" },
        "rejectReason": { "type": "string" },
        "createdAt": { "type": "string" },
        "verifiedAt": { "type": "string" }
      },
      "required": ["token", "referrerUid", "referredUid", "status", "createdAt"]
    },
    "deviceFingerprints": {
      "title": "Device Fingerprint Registry",
      "description": "Known device fingerprints for anti-fraud tracking",
      "type": "object",
      "properties": {
        "fingerprint": { "type": "string" },
        "uids": { "type": "array" },
        "telegramIds": { "type": "array" },
        "referralTokens": { "type": "array" },
        "count": { "type": "number" },
        "lastUsedAt": { "type": "string" }
      },
      "required": ["fingerprint", "uids"]
    },
    "withdrawals": {
      "title": "Withdrawal Requests",
      "description": "User withdrawal payout requests and approval history",
      "type": "object",
      "properties": {
        "withdrawalId": { "type": "string" },
        "userId": { "type": "string" },
        "uid": { "type": "string" },
        "telegramId": { "type": "string" },
        "userName": { "type": "string" },
        "amount": { "type": "number" },
        "method": { "type": "string" },
        "upiId": { "type": "string" },
        "qrImageUrl": { "type": "string" },
        "redeemCodeDetails": { "type": "string" },
        "status": { "type": "string" },
        "rejectReason": { "type": "string" },
        "createdAt": { "type": "string" },
        "processedAt": { "type": "string" }
      },
      "required": ["withdrawalId", "uid", "amount", "method", "status", "createdAt"]
    },
    "aiBroadcastConfig": {
      "title": "AI Broadcast Configuration",
      "description": "Gemini API key and AI Broadcast settings",
      "type": "object",
      "properties": {
        "geminiApiKey": { "type": "string" },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string" }
      }
    },
    "aiBroadcastHistory": {
      "title": "AI Broadcast History",
      "description": "History of AI generated Telegram broadcast messages",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "redeemCode": { "type": "string" },
        "message": { "type": "string" },
        "sentByAdmin": { "type": "string" },
        "targetChat": { "type": "string" },
        "telegramMessageId": { "type": "string" },
        "status": { "type": "string" },
        "errorMessage": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "type", "message", "status", "timestamp"]
    },
    "auditLogs": {
      "title": "Enterprise Audit Logs",
      "description": "Comprehensive security and operational logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "category": { "type": "string" },
        "details": { "type": "string" },
        "adminId": { "type": "string" },
        "timestamp": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "action", "category", "adminId", "timestamp"]
    },
    "scheduledEvents": {
      "title": "Scheduled Events",
      "description": "Pre-scheduled redeem drops and promotional events",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "startDate": { "type": "string" },
        "codeReleaseDate": { "type": "string" },
        "endDate": { "type": "string" },
        "rewardAmount": { "type": "number" },
        "maxClaims": { "type": "number" },
        "code": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "startDate", "codeReleaseDate", "endDate", "rewardAmount", "maxClaims", "code"]
    },
    "eventTemplates": {
      "title": "Event Templates",
      "description": "Reusable event presets (Flash, Golden, Giveaway, VIP)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "rewardAmount": { "type": "number" },
        "maxClaims": { "type": "number" },
        "codePrefix": { "type": "string" },
        "durationMinutes": { "type": "number" }
      },
      "required": ["id", "name", "category", "rewardAmount", "maxClaims", "codePrefix"]
    },
    "announcements": {
      "title": "System Announcements",
      "description": "Global user notices and maintenance alerts",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "priority": { "type": "string" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "title", "message", "priority"]
    },
    "autoRewardRules": {
      "title": "Auto Reward Rules",
      "description": "Automated reward payout rules for events and triggers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "triggerEvent": { "type": "string" },
        "rewardAmount": { "type": "number" },
        "conditions": { "type": "string" },
        "isActive": { "type": "boolean" },
        "totalPaidOut": { "type": "number" }
      },
      "required": ["id", "name", "triggerEvent", "rewardAmount"]
    },
    "hallOfFame": {
      "title": "Hall of Fame",
      "description": "Top typists, winners, and leaderboard champions",
      "type": "object",
      "properties": {
        "telegramId": { "type": "string" },
        "userName": { "type": "string" },
        "totalWins": { "type": "number" },
        "fastestClaimSec": { "type": "number" },
        "totalRewards": { "type": "number" },
        "eventsJoined": { "type": "number" }
      },
      "required": ["telegramId", "totalWins"]
    }
  },
  "firestore": {
    "/settings/admin_config": {
      "schema": "settings",
      "description": "Admin configuration settings"
    },
    "/settings/ai_broadcast": {
      "schema": "aiBroadcastConfig",
      "description": "AI Broadcast Gemini API configuration"
    },
    "/aiBroadcastHistory/{broadcastId}": {
      "schema": "aiBroadcastHistory",
      "description": "History of sent AI Telegram broadcasts"
    },
    "/logs/{logId}": {
      "schema": "logs",
      "description": "System event logs"
    },
    "/users/{userId}": {
      "schema": "users",
      "description": "User profile and wallet account"
    },
    "/transactions/{txId}": {
      "schema": "transactions",
      "description": "User wallet transaction record"
    },
    "/adminLogs/{logId}": {
      "schema": "adminLogs",
      "description": "Admin activity and audit log"
    },
    "/auditLogs/{logId}": {
      "schema": "auditLogs",
      "description": "Enterprise security and operational audit log"
    },
    "/scheduledEvents/{eventId}": {
      "schema": "scheduledEvents",
      "description": "Scheduled events drop schedule"
    },
    "/eventTemplates/{tplId}": {
      "schema": "eventTemplates",
      "description": "Saved event templates"
    },
    "/announcements/{annId}": {
      "schema": "announcements",
      "description": "System wide broadcast announcements"
    },
    "/autoRewardRules/{ruleId}": {
      "schema": "autoRewardRules",
      "description": "Automated wallet credit reward rules"
    },
    "/hallOfFame/{userId}": {
      "schema": "hallOfFame",
      "description": "Global speed drop leaderboards"
    },
    "/referralTokens/{tokenId}": {
      "schema": "referralTokens",
      "description": "Pending and verified referral verification tokens"
    },
    "/deviceFingerprints/{fpId}": {
      "schema": "deviceFingerprints",
      "description": "Anti self-referral device fingerprint log"
    },
    "/withdrawals/{withdrawalId}": {
      "schema": "withdrawals",
      "description": "User withdrawal requests and payout audit records"
    }
  }
}
